# Copy to config/secrets.env (gitignored) and fill in. NEVER commit real values.
# One file for every login, key and credential used by the backends and the frontend.

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: safe for the browser.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Secret key: server only (FastAPI). Never expose to the frontend.
SUPABASE_SECRET_KEY=sb_secret_placeholder
# Database password (used by `supabase db push` / `supabase link`).
SUPABASE_DB_PASSWORD=placeholder

# --- Encryption of students' Claude API keys ---
# 32 random bytes, base64. Generate: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
KEY_ENCRYPTION_KEY=placeholder

# --- Dev only: fallback Claude key when no user key is set (leave blank in production) ---
ANTHROPIC_API_KEY=

# Direct Postgres connection (server only).
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
